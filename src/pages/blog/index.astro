---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPostSlug, getPublishedPosts, postPath } from '../../lib/blog';

const posts = (await getPublishedPosts())
  .filter((post) => post.data.lang === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<SiteLayout
  title="Resources — Bomray Lab"
  description="Guides, product updates, and practical notes from Bomray Lab."
>
  <main class="container">
    <section class="resources">
      <header class="resources-header">
        <h1>Resources</h1>
        <p class="resources-intro">Guides, product updates, and practical notes from Bomray Lab.</p>
      </header>

      <ul class="post-list">
        {posts.map((post) => {
          const slug = getPostSlug(post);
          return (
            <li>
              {post.data.hero && (
                <a class="post-hero-link" href={postPath(slug)} tabindex="-1" aria-hidden="true">
                  <Image
                    class="post-hero"
                    src={post.data.hero}
                    alt=""
                    widths={[420, 640]}
                    sizes="(max-width: 480px) 100vw, 420px"
                  />
                </a>
              )}
              <span class="category-badge">{post.data.category}</span>
              <a class="post-title" href={postPath(slug)}>
                {post.data.title}
              </a>
              <p class="post-meta">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <p class="post-description">{post.data.description}</p>
            </li>
          );
        })}
      </ul>
    </section>
  </main>
</SiteLayout>
