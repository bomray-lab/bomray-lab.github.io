---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout
  title="Bomray Lab — Atlassian Apps"
  description="Bomray Lab builds lightweight productivity apps for Atlassian administrators."
>
  <main>
    <section class="container hero">
      <div>
        <span class="eyebrow">Atlassian Apps</span>
        <h1>Lightweight tools for clearer Jira administration.</h1>
        <p>Bomray Lab builds focused apps that help Jira administrators review their environments with clear evidence and without risky automatic changes.</p>
        <div class="actions">
          <a class="button primary" href="#apps">Explore our app</a>
          <a class="button" href="/support/">Contact support</a>
        </div>
      </div>
      <img class="hero-logo" src="/assets/logo.png" alt="Bomray Lab app icon">
    </section>

    <section class="section" id="apps">
      <div class="container">
        <h2>Our apps</h2>
        <p class="section-intro">Focused products designed to reduce repetitive Jira administration work.</p>

        <article class="card app-card">
          <img src="/assets/logo.png" alt="Needs Attention for Jira icon">
          <div>
            <span class="eyebrow">Available soon</span>
            <h3>Needs Attention for Jira</h3>
            <p>Identify Jira projects, custom fields, filters, and dashboards that require administrator review.</p>
            <div class="features">
              <div class="feature">
                <strong>Evidence-based review</strong>
                <p>See why each resource was flagged before taking action.</p>
              </div>
              <div class="feature">
                <strong>No automatic changes</strong>
                <p>The app never deletes, archives, or modifies Jira resources.</p>
              </div>
              <div class="feature">
                <strong>Scan history</strong>
                <p>Compare review results over time and track meaningful changes.</p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="container card">
        <h2>Built for administrators who want control.</h2>
        <p class="section-intro">No AI wrapper. No automatic cleanup. Just practical workflow tools that help administrators focus on what deserves attention.</p>
        <a class="button" href="/support/">Get support</a>
      </div>
    </section>
  </main>
</SiteLayout>
